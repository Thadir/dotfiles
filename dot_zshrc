# ~/.zshrc — interactive zsh startup. Framework + prompt only; personal
# aliases / colours / completion styling live in ~/.zsh_profile (sourced below).
#
# Load order matters:
#   1. Homebrew shellenv   — so everything after can find brew binaries
#   2. oh-my-zsh           — framework + plugins
#   3. ~/.zsh_profile      — personal config (needs brew binaries: gls, vivid)
#   4. ~/.zsh_secrets      — secrets pulled from the OS keychain (no values on disk)
#   5. starship init       — the prompt
#   6. machine PATH extras

# --- 1. Homebrew ---------------------------------------------------------
# Apple Silicon: /opt/homebrew. Intel mac / Linuxbrew: adjust the path.
# Guarded because ~/.zsh_profile's dependency check is what installs Homebrew
# on a machine that doesn't have it yet.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# --- 2. oh-my-zsh -------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"

# Prompt is handled by Starship (step 5), so no oh-my-zsh theme is loaded.
ZSH_THEME=""

# Keep this list minimal — every plugin adds startup cost.
#   git       — branch/status helpers + aliases
#   gnu-utils — hashes bare GNU tool names (ls, grep, ...) to gls/ggrep etc.
plugins=(git gnu-utils)

source "$ZSH/oh-my-zsh.sh"

# --- 3. personal config ----------------------------------------------
# See ~/.zsh_profile's header for why it's a plain sourced script and not
# the real ~/.zprofile.
[ -r ~/.zsh_profile ] && source ~/.zsh_profile

# --- 4. secrets ------------------------------------------------------
# ~/.zsh_secrets contains NO secret values — only keychain lookups that
# export tokens at startup. Safe to track in chezmoi. See that file's header.
[ -r ~/.zsh_secrets ] && source ~/.zsh_secrets

# --- 5. prompt -----------------------------------------------------
# Config: ~/.config/starship.toml (generated by ~/.config/starship-gen.py).
eval "$(starship init zsh)"

# --- 6. machine PATH extras ---------------------------------------
export PATH="/usr/local/sbin:$PATH"
