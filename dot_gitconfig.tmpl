{{- $root := .projects_root -}}
# ~/.gitconfig  (managed by chezmoi -- edit dot_gitconfig.tmpl, not this file)

# --- Default identity: PERSONAL -----------------------------------------
# Work identities are NEVER the default. If you clone something outside a
# configured project directory you commit as yourself, not as a customer.
[user]
	name = {{ .name_personal }}
	email = {{ .email_personal }}
[github]
	user = {{ .name_personal }}

# Default SSH route: the personal host alias (see ~/.ssh/config), so remotes
# can stay written as git@github.com:... and still use the personal key.
[url "git@{{ .ssh_host_personal }}:"]
	insteadOf = git@github.com:

[core]
	editor = vim
	pager = cat
	filemode = false
	autocrlf = input

# --- Per-directory identity overrides ---------------------------------------
# Trailing slash = the whole subtree. Later match wins, so a repo covered by
# two rules takes the last one listed. Directory lists come from
# ~/.config/chezmoi/chezmoi.toml.

# Employer / corporate
{{ range (splitList "," .employer_dirs) -}}
{{ $d := trim . -}}
{{ if $d -}}
[includeIf "gitdir:{{ $root }}/{{ $d }}/"]
	path = ~/.config/git/employer.inc
{{ end -}}
{{ end }}
# Enterprise Managed User (EMU) account
{{ range (splitList "," .emu_dirs) -}}
{{ $d := trim . -}}
{{ if $d -}}
[includeIf "gitdir:{{ $root }}/{{ $d }}/"]
	path = ~/.config/git/emu.inc
{{ end -}}
{{ end }}
# Customer-specific accounts (from [[data.customer]] in chezmoi.toml)
{{ range (dig "customer" (list) .) -}}
{{ $dir := dig "dir" (printf "%s/%s" $root .slug) . -}}
[includeIf "gitdir:{{ $dir }}/"]
	path = ~/.config/git/customer-{{ .slug }}.inc
{{ end -}}
