# Personal GitHub account. Included by ~/.gitconfig for the personal project dirs.
[user]
	name = {{ .name_personal }}
	email = {{ .email_personal }}

# Route plain github.com SSH URLs through the personal host alias (defined in
# ~/.ssh/config, which selects the matching key), so remotes can stay written
# as git@github.com:... and still use the right identity.
[url "git@{{ .ssh_host_personal }}:"]
	insteadOf = git@github.com:
