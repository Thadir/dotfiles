# ~/.zsh_secrets — secrets for interactive shells.
#
# This file contains NO secret values. It looks each one up in the OS secret
# store at shell startup and exports it. Safe to track in chezmoi / git.
# Sourced by ~/.zshrc (step 4). Kept chmod 600 anyway (chezmoi: private_).
#
# --- GitHub ---------------------------------------------------------------
# Do NOT export GITHUB_TOKEN here. The `gh` CLI stores its own logins in the
# OS keyring (`gh auth login`); an exported GITHUB_TOKEN overrides that and
# pins gh to one account, breaking `gh auth switch` on a multi-account setup.
#   Switch account:    gh auth switch                (interactive picker)
#   Token for scripts: gh auth token                 (active account)
#   Add an account:    gh auth login
# Git push/pull uses SSH (~/.ssh/config host aliases), not a token.
#
# --- Other secrets ------------------------------------------------------
# For anything that genuinely needs an env var, use the helper below.
#
# Store one first (value is prompted, never echoed):
#   macOS:        security add-generic-password -a "$USER" -s SOME_NAME -w
#   Linux / WSL:  pass insert cli/SOME_NAME
#                 secret-tool store --label='...' service SOME_NAME

# Fetch one secret by name from whichever store is available. Prints nothing
# (and returns non-zero) if the store or the entry is missing.
_secret() {
  local name=$1
  if [[ "$OSTYPE" == darwin* ]] && command -v security >/dev/null 2>&1; then
    security find-generic-password -a "$USER" -s "$name" -w 2>/dev/null
  elif command -v pass >/dev/null 2>&1; then
    pass show "cli/$name" 2>/dev/null | head -1
  elif command -v secret-tool >/dev/null 2>&1; then
    secret-tool lookup service "$name" 2>/dev/null
  fi
}

# Example — uncomment and adapt per secret:
#   SOME_TOKEN="$(_secret SOME_NAME)" && [[ -n "$SOME_TOKEN" ]] && export SOME_TOKEN

unset -f _secret
