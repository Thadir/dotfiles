{{- /* Identity model (see docs/setup.md):
       - PERSONAL is the default for every repo. Work identities are never the
         default -- you opt into them per directory.
       - EMPLOYER  = your main employer / corporate identity.
       - EMU       = a separate Enterprise Managed User account, if your
                     organisation issues you one for certain repositories.
                     Optional -- leave the email blank to skip it entirely
                     (e.g. on a customer-owned machine where that account
                     should never be used).
       - CUSTOMER  = customer-specific accounts. Not prompted here; add
                     [[data.customer]] blocks to ~/.config/chezmoi/chezmoi.toml
                     (see docs/setup.md "Adding a customer account"), then
                     chezmoi apply. Existing blocks survive `chezmoi init`.
*/ -}}
{{- /* Fallbacks from the pre-identity-split key names, so `chezmoi init` on a
       machine set up with the old config pre-fills instead of re-asking. */ -}}
{{- $oldName      := dig "name"          "" . -}}
{{- $oldEmailWork := dig "email_work"    "" . -}}
{{- $oldSshWork   := dig "ssh_host_work" "github.com-work" . -}}
{{- $oldWorkDirs  := dig "work_dirs"     "work" . -}}

{{- $namePersonal    := promptStringOnce . "name_personal"     "Name on your PERSONAL commits" -}}
{{- $emailPersonal   := promptStringOnce . "email_personal"    "Personal email" -}}
{{- $sshHostPersonal := promptStringOnce . "ssh_host_personal" "SSH host alias for the personal GitHub account (see ~/.ssh/config)" "github.com-personal" -}}

{{- $nameEmployer    := promptStringOnce . "name_employer"     "Name on EMPLOYER commits" (or $oldName $namePersonal) -}}
{{- $emailEmployer   := promptStringOnce . "email_employer"    "Employer email" $oldEmailWork -}}
{{- $sshHostEmployer := promptStringOnce . "ssh_host_employer" "SSH host alias for the employer GitHub account" $oldSshWork -}}

{{- /* EMU is opt-in: the email decides whether the rest gets asked at all, so
       skipping it (blank) doesn't also mean answering two more prompts for
       nothing -- important on a machine that should never carry that account. */ -}}
{{- $emailEmu := promptStringOnce . "email_emu" "EMU account email (leave blank if you don't use one on this machine)" "" -}}
{{- $nameEmu := $nameEmployer -}}
{{- $sshHostEmu := "" -}}
{{- if ne $emailEmu "" -}}
{{- $nameEmu = promptStringOnce . "name_emu" "Name on the EMU account's commits" $nameEmployer -}}
{{- $sshHostEmu = promptStringOnce . "ssh_host_emu" "SSH host alias for the EMU account" "github.com-emu" -}}
{{- end -}}

{{- $projectsRoot := promptStringOnce . "projects_root" "Projects root directory" "~/projects" -}}

{{- /* Auto-discover existing subdirectories of the projects root and fold them
       into the prompts below as a hint -- it never guesses which account owns
       which directory, it just saves you typing names from memory. Silently
       empty on a brand-new machine where the root doesn't exist yet. */ -}}
{{- $globRoot := $projectsRoot -}}
{{- if hasPrefix "~/" $globRoot -}}
{{- $globRoot = joinPath .chezmoi.homeDir (trimPrefix "~/" $globRoot) -}}
{{- else if eq $globRoot "~" -}}
{{- $globRoot = .chezmoi.homeDir -}}
{{- end -}}
{{- $discoveredDirs := list -}}
{{- range (glob (printf "%s/*" $globRoot)) -}}
{{- $name := base . -}}
{{- if and (stat .).isDir (not (hasPrefix "." $name)) -}}
{{- $discoveredDirs = mustAppend $discoveredDirs $name -}}
{{- end -}}
{{- end -}}
{{- $dirHint := "" -}}
{{- if $discoveredDirs -}}
{{- $dirHint = printf " (found: %s)" ($discoveredDirs | join ", ") -}}
{{- end -}}

{{- $employerDirs := promptStringOnce . "employer_dirs" (printf "Comma-separated subdirs of the projects root that use the EMPLOYER account%s" $dirHint) $oldWorkDirs -}}
{{- $emuDirs := "" -}}
{{- if ne $emailEmu "" -}}
{{- $emuDirs = promptStringOnce . "emu_dirs" (printf "Comma-separated subdirs that use the EMU account%s" $dirHint) "emu" -}}
{{- end -}}

[data]
    name_personal     = {{ $namePersonal | quote }}
    email_personal    = {{ $emailPersonal | quote }}
    ssh_host_personal = {{ $sshHostPersonal | quote }}

    name_employer     = {{ $nameEmployer | quote }}
    email_employer    = {{ $emailEmployer | quote }}
    ssh_host_employer = {{ $sshHostEmployer | quote }}

    name_emu          = {{ $nameEmu | quote }}
    email_emu         = {{ $emailEmu | quote }}
    ssh_host_emu      = {{ $sshHostEmu | quote }}

    projects_root     = {{ $projectsRoot | quote }}
    employer_dirs     = {{ $employerDirs | quote }}
    emu_dirs          = {{ $emuDirs | quote }}
{{ range (dig "customer" (list) .) }}
[[data.customer]]
slug = {{ .slug | quote }}
name = {{ (dig "name" $namePersonal .) | quote }}
email = {{ .email | quote }}
{{- $d := dig "dir" "" . }}{{ if $d }}
dir = {{ $d | quote }}
{{- end }}
{{- $s := dig "ssh_host" "" . }}{{ if $s }}
ssh_host = {{ $s | quote }}
{{- end }}
{{ end -}}
